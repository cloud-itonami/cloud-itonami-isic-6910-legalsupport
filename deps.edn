{:paths ["src"]
 :deps {io.github.kotoba-lang/langgraph
        {:git/sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
        ;; 有資格者レコードの検査を自前で持たず commons に委ねる
        ;; （ADR-2607262500 D1 で宣言した「触るついでに寄せる」の履行）。
        io.github.cloud-itonami/cloud-itonami-licensed-operator
        {:local/root "../cloud-itonami-licensed-operator"}}
 :aliases
 {;; clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}
  ;; clojure -M:emit-datoms -> regenerate data/jurisdiction-rules.datoms.edn
  ;; from src/legalsupport/facts.cljc (generated file, never hand-edited).
  :emit-datoms {:main-opts ["-m" "legalsupport.datoms"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
